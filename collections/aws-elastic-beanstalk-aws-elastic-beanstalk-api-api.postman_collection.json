    "_postman_id": "1bb84f44-3217-4edd-b6ba-993d35db6662",
    "name": "AWS Elastic Beanstalk AWS Elastic Beanstalk API API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "AWS Elastic Beanstalk is a Platform-as-a-Service offering for deploying\nand scaling web applications and services. The Elastic Beanstalk Query\nAPI accepts POST requests to the root path with the Action and Version\nspecified as parameters and the operation input in the\napplication/x-www-form-urlencoded request body. All requests are signed\nwith AWS Signature Version 4 (SigV4).\n\nSee https://docs.aws.amazon.com/elasticbeanstalk/latest/api/Welcome.html\n",
      "type": "text/plain"
    }
  }
